--- a/pkg/highway/build.zig	2026-11-06 23:28:06.000000000 +0100
+++ b/pkg/highway/build.zig	2026-11-10 02:27:16.916848100 +0100
@@ -121,6 +121,16 @@
         lib.root_module.stack_protector = false;
     }
 
+    // OpenMandriva zig 0.17 ships a broken amxtf32intrin.h. Defining the
+    // include guard skips it. immintrin.h pulls it in unconditionally.
+    try flags.append(b.allocator, "-D__AMX_TF32INTRIN_H");
+
+    // zig 0.17's arm_neon.h declares bf16 helpers whose builtins are
+    // missing. HWY_NEON_BF16 is (1LL << 26). Baseline NEON stays on.
+    if (target.result.cpu.arch == .aarch64) {
+        try flags.append(b.allocator, "-DHWY_DISABLED_TARGETS=(1LL<<26)");
+    }
+
     lib.root_module.addCSourceFiles(.{ .flags = flags.items, .files = &.{
         "src/cpp/abort.cc",
         "src/cpp/per_target.cc",
